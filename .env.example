# OpenAI-compatible chat model
MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://your-provider.example/v1

# Local SentenceTransformer model directory used for RAG and conversation memory
# BGE_MODEL_PATH=D:/models/bge-base-zh-v1.5

# Only needed when directly instantiating apps.common.models.BgeEmbeddings
# EMBEDDING_API_KEY=replace-with-your-embedding-key
# EMBEDDING_BASE_URL=https://your-provider.example/v1/embeddings

# Optional Text2SQL datasource. Queries are restricted to one read-only SELECT/WITH statement.
# TEXT2SQL_DATABASE_URL=sqlite:///D:/data/business.db
# TEXT2SQL_MAX_ROWS=100
